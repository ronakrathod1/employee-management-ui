DB_USER=postgres
DB_HOST=localhost
DB_NAME=employee_management
DB_PASSWORD=replace_with_your_postgres_password
DB_PORT=5432

# Optional: change when deploying the frontend.
FRONTEND_URL=http://localhost:5173

# Used to sign login tokens. Use a long, random string in production
# (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace_with_a_long_random_string

# Used once by `npm run seed` to create the first HR admin account.
ADMIN_NAME=HR Admin
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=changeme123
